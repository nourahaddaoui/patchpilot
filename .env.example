# Copy to .env (git-ignored) and fill in. Never commit a real key.
OPENAI_API_KEY=
# Optional
# PATCHPILOT_MODEL=gpt-4o-mini
# PATCHPILOT_PRICE_IN=0.15     # USD per 1M input tokens, needed for models not in agent/model.py
# PATCHPILOT_PRICE_OUT=0.60    # USD per 1M output tokens
# PATCHPILOT_TRIVY_CACHE=D:/patchpilot-cache/trivy   # Trivy DB location if not .cache/trivy (the DB is ~1.6 GB)

# GitHub mode (see README "GitHub mode"). Use a test repo.
# PATCHPILOT_ISSUES=github
# PATCHPILOT_GITHUB_REPO=owner/name
# GITHUB_TOKEN=     # fine-grained, that repo only: Actions read; Contents, Issues, Pull requests read and write. No Administration.

# The admin token does NOT go here. scripts/reset_demo_repo.py reads it only from
# .env.admin (git-ignored), so the agent's process never has it:
#   .env.admin
#   PATCHPILOT_ADMIN_TOKEN=   # fine-grained, demo repo only: Administration, Contents, Issues, Pull requests read and write
